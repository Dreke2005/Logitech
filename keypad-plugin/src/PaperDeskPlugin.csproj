<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../bin/$(Configuration)/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LogiPluginApi" Version="6.4.2.3567" ExcludeAssets="runtime;native" />
    <EmbeddedResource Include="../../paper_menus.json" LogicalName="PaperMenus.json" />
    <EmbeddedResource Include="../icons/**/*.png" />
  </ItemGroup>
  <Target Name="CopyManifest" AfterTargets="Build">
    <Copy SourceFiles="../metadata/LoupedeckPackage.yaml;../metadata/DefaultIconTemplate.ict"
          DestinationFolder="$(OutputPath)../metadata/" />
  </Target>
</Project>
